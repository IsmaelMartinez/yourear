{
  "name": "yourear",
  "version": "1.0.2",
  "private": true,
  "description": "A browser-based hearing assessment tool using the Web Audio API",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hearing",
    "audiometry",
    "web-audio-api",
    "audiogram",
    "hearing-test"
  ],
  "author": "Ismael Martinez",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  }
}
